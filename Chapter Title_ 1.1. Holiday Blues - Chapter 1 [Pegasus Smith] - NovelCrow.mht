@charset "utf-8";

.mn-container-title { font-size: 20px; padding: 0px 0px 3px; font-family: Arial, Helvetica, sans-serif; text-align: left; }

.mn-container-title.mn-container-title_position_left { text-align: left; }

.mn-container-title.mn-container-title_position_right { text-align: right; }

.mn-container-adsby { font-size: 11px; line-height: 12px; font-family: Arial, Helvetica, sans-serif; padding: 0px 0px 6px; text-align: right; }

.mn-container-adsby.mn-container-adsby_position_left, .mn-container-adsby.mn-container-adsby_position_bottom-left { text-align: left; }

.mn-container-adsby.mn-container-adsby_position_right, .mn-container-adsby.mn-container-adsby_position_bottom-right { text-align: right; }

.mn-container-adsby__link { color: rgb(153, 153, 153); text-decoration: none; }

.mn-container-adsby__a { text-decoration: underline; }

.mn-container-adsby-info { width: 14px; height: 14px; display: inline-block; line-height: 0; padding: 2px; position: relative; box-sizing: content-box; }

.mn-container-adsby-info__icon { display: block; width: 100%; height: 100%; background: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%20width%3D%2716%27%20height%3D%2716%27%20viewBox%3D%270%200%2016%2016%27%3E%3Cg%20fill%3D%27none%27%20fill-rule%3D%27evenodd%27%3E%3Cpath%20d%3D%27M0%200h16v16H0z%27/%3E%3Cpath%20d%3D%27M8%201.333A6.67%206.67%200%200%200%201.333%208%206.67%206.67%200%200%200%208%2014.667%206.67%206.67%200%200%200%2014.667%208%206.67%206.67%200%200%200%208%201.333zm.667%2010H7.333v-4h1.334v4zm0-5.333H7.333V4.667h1.334V6z%27%20fill%3D%27%23CDCDCD%27%20fill-rule%3D%27nonzero%27/%3E%3C/g%3E%3C/svg%3E") 50% 50% no-repeat; }

.mn-container-adsby-info__msg { display: none; position: absolute; background: rgb(204, 204, 204); height: 14px; padding: 2px 4px; line-height: 14px; font-size: 11px; color: rgb(255, 255, 255); white-space: nowrap; top: 0px; left: 18px; text-decoration: none; text-align: left; box-sizing: content-box; border-radius: 4px; }

.mn-container-adsby-info__msg_bottom-left, .mn-container-adsby-info__msg_left { right: auto; left: 18px; padding-left: 3px; }

.mn-container-adsby-info__msg_bottom-right, .mn-container-adsby-info__msg_right { left: auto; right: 18px; padding-right: 3px; }

.mn-container-adsby-info:hover .mn-container-adsby-info__msg { display: block; }

.mn-thumb__label { display: block; height: 82px; margin-left: 0px; margin-right: 0px; padding: 0px 5px; -webkit-line-clamp: 2; font-family: Arial, Helvetica, sans-serif; }

.mn-thumb__label_deferred { background: none !important; }

.mn-thumb__label-title { text-decoration: none; margin: 0px; padding: 2px 0px 0px; display: block; overflow: hidden; white-space: pre-wrap; overflow-wrap: break-word; max-height: 65px; color: rgb(0, 0, 0); box-sizing: content-box; position: relative; z-index: 3; -webkit-box-orient: vertical; width: auto !important; }

.mn-thumb__label-title-link { display: block; color: rgb(0, 0, 0); font-size: 14px; line-height: 1.3em; font-weight: normal; }

.mn-thumb__label-brand { color: rgb(153, 153, 153); font-size: 11px; font-weight: bold; text-decoration: none; background-image: none; line-height: 1.2em; max-height: 22px; overflow: hidden; display: block; padding: 3px 0px 0px; box-sizing: content-box; position: relative; z-index: 3; }

.mn-thumb__label-brand-link { color: rgb(153, 153, 153); }

.mn-thumb__label-brand-icon { background-repeat: no-repeat; background-position-y: center; padding-left: 20px; }

.mn-thumb { --mn-thumb-zoom: 1.1; direction: ltr; overflow: hidden; background: none rgba(0, 0, 0, 0); padding: 0px; height: auto; width: 98.99%; border-width: 0px; border-radius: 0px; border-style: none; position: relative; float: left; margin: 0px 0px 1% 1%; cursor: default !important; }

.mn-thumb a { border: 0px; cursor: pointer; outline: 0px; text-decoration: none !important; }

.mn-thumb__holder { position: relative; width: 100%; height: auto; overflow: hidden; }

.mn-thumb__img { border-width: 0px; border-radius: 0px; border-style: none; background-color: rgba(0, 0, 0, 0); background-position: center center; background-repeat: no-repeat; background-size: cover; display: inline-block; position: absolute; inset: 0px; margin: 0px; transition: 0.3s ease-in-out; overflow: hidden !important; }

.mn-thumb__img:hover { transform: scale(1.3, 1.3); }

.mn-thumb__img.mn-thumb__img_no-img { background: rgb(204, 204, 204); }

.mn-thumb__video { border-width: 0px; border-radius: 0px; border-style: none; display: inline-block; position: absolute; top: var(--mn-video-cy, 50%); left: var(--mn-video-cx, 50%); transform: translate(calc(var(--mn-video-cx, 50%) * -1), calc(var(--mn-video-cy, 50%) * -1)) scale(1); width: 100%; height: 100%; object-fit: cover; overflow: hidden !important; }

.mn-thumb__iframe { position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; overflow: hidden; }

.mn-thumb_iframe .mn-thumb__label { pointer-events: none; }

.mn-thumb.mn-thumb--zoom .mn-thumb__img, .mn-thumb.mn-thumb--zoom .mn-thumb__video, .mn-thumb.mn-thumb--zoom .mn-thumb__iframe { transform-origin: center center; transition: transform 0.4s ease-in-out; }

.mn-thumb.mn-thumb--zoom:hover .mn-thumb__img, .mn-thumb.mn-thumb--zoom:hover .mn-thumb__iframe { transform: scale(var(--mn-thumb-zoom, 1.1)); }

.mn-thumb.mn-thumb--zoom:hover .mn-thumb__video { transform: translate(calc(var(--mn-video-cx, 50%) * -1), calc(var(--mn-video-cy, 50%) * -1)) scale(var(--mn-thumb-zoom, 1.1)); }

.mn-thumb__arrow { position: absolute; z-index: 4; right: 6px; bottom: 6px; width: 26.7px; height: 26.7px; cursor: pointer; background-color: rgb(0, 0, 0); border-radius: 50%; display: inline-block; background-image: url("data:image/svg+xml,%3Csvg width='33.3' height='33.3' viewBox='0 0 33.3 33.3' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M9 16.65h15.3M24.3 16.65l-8.35-8.35M24.3 16.65l-8.35 8.35' stroke='%23fff' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"); background-repeat: no-repeat; background-position: center center; background-size: 100% 80%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

.mn-thumb__video.mn-thumb__img_no-img { background: rgb(204, 204, 204); height: 100%; }

.mn-thumb__tracker { position: absolute; top: 30%; left: 50%; margin: 0px; padding: 0px; border: 0px; opacity: 0; visibility: hidden; }

.mn-thumb__aspect { width: 1px; }

.mn-thumb-spinner { text-align: center; position: absolute; inset: 0px; width: 50%; height: 14px; margin: auto; }

.mn-thumb-spinner__disc { width: 14px; height: 14px; background-color: rgb(51, 51, 51); border-radius: 100%; display: inline-block; animation: 1.4s ease-in-out 0s infinite normal both running mn-thumb-spinner-bouncedelay; }

.mn-thumb-spinner__disc-1 { animation-delay: -0.32s; }

.mn-thumb-spinner__disc-2 { animation-delay: -0.16s; }

@keyframes mn-thumb-spinner-bouncedelay { 
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

.gender-icon { height: 100%; width: 100%; background-repeat: no-repeat; }

.gender-icon__wrapper { position: absolute; z-index: 10; top: 4px; width: 18px; height: 18px; padding: 1px 2px; background-color: rgba(0, 0, 0, 0.6); border-radius: 3px; }

